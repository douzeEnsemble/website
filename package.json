    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.5"
  }
}
